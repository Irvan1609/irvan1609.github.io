name = "hitung-cabai-api"
main = "src/index.js"
compatibility_date = "2026-09-25"

[vars]
ALLOWED_ORIGINS = "https://irvan1609.github.io"
ADMIN_EMAILS = "andyirvan1609@gmail.com"
GOOGLE_REDIRECT_URI = "https://hitung-cabai-api.andyirvan1609.workers.dev/v1/auth/google/callback"
MIDTRANS_ENV = "sandbox"
MEMBERSHIP_PUBLIC_BASE_URL = "https://hitung-cabai-api.andyirvan1609.workers.dev"
# Set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, MIDTRANS_SERVER_KEY, TURNSTILE_SECRET,
# and ADMIN_TOKEN with Wrangler secrets or the Cloudflare dashboard.

[[d1_databases]]
binding = "DB"
database_name = "hitung-cabai"
database_id = "ISI_DATABASE_ID_D1"


# Optional but recommended for logical D1 disaster-recovery snapshots.
[[r2_buckets]]
binding = "BACKUPS"
bucket_name = "irvan-backups"

# Daily logical backup. The scheduled handler skips cleanly when BACKUPS is absent.
[triggers]
crons = ["0 18 * * *"]
