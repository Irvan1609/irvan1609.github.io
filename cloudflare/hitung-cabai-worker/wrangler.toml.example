name = "hitung-cabai-api"
main = "src/index.js"
compatibility_date = "2026-09-25"

[vars]
ALLOWED_ORIGINS = "https://irvan1609.github.io,https://agrotik.pages.dev,https://agrotik-irvan1609.pages.dev"
ADMIN_EMAILS = "andyirvan1609@gmail.com"
GOOGLE_REDIRECT_URI = "https://hitung-cabai-api.andyirvan1609.workers.dev/v1/auth/google/callback"
MIDTRANS_ENV = "sandbox"
MEMBERSHIP_PUBLIC_BASE_URL = "https://hitung-cabai-api.andyirvan1609.workers.dev"
IDEMPOTENCY_RETENTION_DAYS = "14"
AUDIT_RETENTION_DAYS = "90"
DELETED_DATASET_RETENTION_DAYS = "30"
CLOUD_RETRY_SECONDS = "300"
# Set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, MIDTRANS_SERVER_KEY, TURNSTILE_SECRET,
# and ADMIN_TOKEN with Wrangler secrets or the Cloudflare dashboard.

[[d1_databases]]
binding = "DB"
database_name = "hitung-cabai"
database_id = "ISI_DATABASE_ID_D1"


[[ratelimits]]
name = "CONTRIBUTION_RATE_LIMITER"
namespace_id = "91609001"

[ratelimits.simple]
limit = 30
period = 60

[[ratelimits]]
name = "DATASET_RATE_LIMITER"
namespace_id = "91609002"

[ratelimits.simple]
limit = 180
period = 60

# Recommended: large contribution images live in R2; D1 keeps metadata only.
[[r2_buckets]]
binding = "IMAGES"
bucket_name = "irvan-contribution-images"

# Optional but recommended for logical D1 disaster-recovery snapshots.
[[r2_buckets]]
binding = "BACKUPS"
bucket_name = "irvan-backups"

# Daily maintenance always runs; logical backup is added when BACKUPS is configured.
[triggers]
crons = ["0 18 * * *"]


# Setelah bucket BACKUPS tersedia, workflow production memasang lifecycle:
# - d1-logical/  -> 30 hari
# - d1-monthly/  -> 365 hari
# Foto pada bucket IMAGES tidak diberi expiry otomatis.
