name = "hitung-cabai-api"
main = "src/index.js"
compatibility_date = "2026-09-25"

[vars]
ALLOWED_ORIGINS = "https://irvan1609.github.io"
GOOGLE_REDIRECT_URI = "https://hitung-cabai-api.andyirvan1609.workers.dev/v1/auth/google/callback"
# Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET with Wrangler secrets or the Cloudflare dashboard.

[[d1_databases]]
binding = "DB"
database_name = "hitung-cabai"
database_id = "ISI_DATABASE_ID_D1"
