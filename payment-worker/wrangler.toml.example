name = "statistical-web-payment"
main = "src/index.js"
compatibility_date = "2026-09-18"

[vars]
MIDTRANS_ENV = "sandbox"
ANALYSIS_PRICE_IDR = "5000"
ALLOWED_ORIGIN = "https://irvan1609.github.io"
PUBLIC_BASE_URL = "https://YOUR-WORKER.workers.dev"

[[d1_databases]]
binding = "DB"
database_name = "statistical-web-payments"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
